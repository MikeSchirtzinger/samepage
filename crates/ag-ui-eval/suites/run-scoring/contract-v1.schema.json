{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MikeSchirtzinger/samepage/tree/main/crates/ag-ui-eval/suites/run-scoring/contract-v1.schema.json",
  "title": "AG-UI post-hoc run-scoring batch contract v1",
  "description": "Receipt shape for sessions selected by an external sampler. This schema does not implement sampling or score a live session.",
  "type": "object",
  "required": [
    "schema_version",
    "layer",
    "contract_id",
    "sampling",
    "sessions",
    "summary"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "layer": {
      "const": "run_scoring"
    },
    "contract_id": {
      "type": "string",
      "minLength": 1
    },
    "sampling": {
      "type": "object",
      "required": [
        "population",
        "method",
        "window_start",
        "window_end",
        "sampler_version",
        "inclusion_rule"
      ],
      "properties": {
        "population": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "window_start": {
          "type": "string",
          "format": "date-time"
        },
        "window_end": {
          "type": "string",
          "format": "date-time"
        },
        "sampler_version": {
          "type": "string",
          "minLength": 1
        },
        "inclusion_rule": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "sessions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/session"
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "sampled",
        "passed",
        "failed",
        "skipped"
      ],
      "properties": {
        "sampled": {
          "type": "integer",
          "minimum": 0
        },
        "passed": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "provider": {
      "type": "object",
      "required": [
        "adapter",
        "name",
        "model"
      ],
      "properties": {
        "adapter": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "threshold": {
      "type": "object",
      "required": [
        "op",
        "value"
      ],
      "properties": {
        "op": {
          "enum": [
            "eq",
            "contains",
            "gte",
            "lte"
          ]
        },
        "value": true
      },
      "additionalProperties": false
    },
    "scorer": {
      "type": "object",
      "required": [
        "id",
        "observed",
        "threshold",
        "passed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "observed": true,
        "threshold": {
          "$ref": "#/$defs/threshold"
        },
        "passed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "reason": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "reason"
          ],
          "properties": {
            "status": {
              "const": "skipped"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "session": {
      "type": "object",
      "required": [
        "session_id",
        "selected_at",
        "selection_probability",
        "source_ref",
        "extension_id",
        "capabilities",
        "provider",
        "outcome",
        "scorers"
      ],
      "properties": {
        "session_id": {
          "type": "string",
          "minLength": 1
        },
        "selected_at": {
          "type": "string",
          "format": "date-time"
        },
        "selection_probability": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "extension_id": {
          "type": "string",
          "minLength": 1
        },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provider": {
          "$ref": "#/$defs/provider"
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "scorers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scorer"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
