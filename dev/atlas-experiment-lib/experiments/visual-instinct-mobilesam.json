{
  "schema_version": 1,
  "id": "visual-instinct-mobilesam",
  "description": "Real MobileSAM WebGPU positive control for the Atlas experiment lifecycle.",
  "host": {
    "command": [
      "cargo",
      "run",
      "-p",
      "visual-instinct-lab"
    ],
    "cwd": ".",
    "environment": {
      "CARGO_TARGET_DIR": "{repo_root}/.local/atlas-experiment-cargo-target"
    },
    "ready_url": "http://127.0.0.1:8111/",
    "ready_timeout_ms": 120000,
    "shutdown_timeout_ms": 5000
  },
  "browser": {
    "port": 9222,
    "start_command": [
      "browser-start"
    ],
    "stop_command": [
      "browser-stop"
    ]
  },
  "gates": [
    {
      "id": "agent-harness",
      "phase": "before",
      "required": true,
      "command": [
        "python3",
        "dev/agent-harness/check.py",
        "--json"
      ]
    },
    {
      "id": "segmentation-contract-drift",
      "phase": "before",
      "required": true,
      "command": [
        "dev/atlas-segmentation-contract",
        "check"
      ]
    }
  ],
  "phases": [
    {
      "id": "mobilesam-webgpu",
      "url": "http://127.0.0.1:8111/?learning=mobilesam-vit-t-webgpu-segmentation&segmentation-model=mobilesam-vit-t",
      "driver": "dev/atlas-experiment-lib/drivers/visual-instinct-mobilesam.mjs",
      "timeout_ms": 120000,
      "restart_host": false,
      "input": {
        "model_id": "mobilesam-vit-t",
        "manifest_timeout_ms": 20000,
        "minimum_graph_parity_iou": 0.99,
        "expected": {
          "contract_sha256": "6fca40e4674e9acf68c80e2046b10d51eb1257b19be07904f5fa6bb484b7425b",
          "worker_postprocess": "sam-low-res-bilinear-crop-source-v1",
          "encoder_sha256": "d80de6055095e7ba5551e6c15aaa8981b05dca77d6ae77ee82e51e2746a87e3d",
          "decoder_sha256": "a21b65b6e1b75e2c6265b36835747a0ab9169ec1ed725139a78ce90297f95126",
          "artifact_bytes": 44493172,
          "fixture_sha256": "c02019c4979c191eb739ddd944445ef408dad5679acab6fd520ef9d434bfbc63",
          "occlusion_fixture_sha256": "20b14ae8b6ab6a7b871f6a70b1181fc66407df6a444138af3c0f3f5dafdaa613",
          "encoder_input_shape": [
            1,
            3,
            1024,
            1024
          ],
          "encoder_output_shape": [
            1,
            256,
            64,
            64
          ],
          "owl_recipe": {
            "id": "mechanical-owl-wing-flap-v1",
            "body_box": [
              530,
              205,
              1005,
              845
            ],
            "part_roles": [
              "left-wing",
              "right-wing"
            ],
            "part_boxes": [
              [
                540,
                430,
                700,
                770
              ],
              [
                840,
                430,
                1000,
                770
              ]
            ],
            "control_id": "flap",
            "motion_units": [
              35,
              -35
            ]
          }
        }
      }
    }
  ]
}
