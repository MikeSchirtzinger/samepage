{
  "schema_version": 1,
  "id": "visual-instinct-segmentation-composite",
  "description": "Real MobileSAM Worker segmentation and WebGPU scene-object compositing proof.",
  "host": {
    "command": [
      "cargo",
      "run",
      "-p",
      "visual-instinct-lab"
    ],
    "cwd": ".",
    "environment": {
      "CARGO_TARGET_DIR": "{repo_root}/.local/atlas-experiment-cargo-target"
    },
    "ready_url": "http://127.0.0.1:8111/",
    "ready_timeout_ms": 120000,
    "shutdown_timeout_ms": 5000
  },
  "browser": {
    "port": 9222,
    "start_command": [
      "browser-start"
    ],
    "stop_command": [
      "browser-stop"
    ]
  },
  "gates": [
    {
      "id": "agent-harness",
      "phase": "before",
      "required": true,
      "command": [
        "python3",
        "dev/agent-harness/check.py",
        "--json"
      ]
    },
    {
      "id": "segmentation-contract-drift",
      "phase": "before",
      "required": true,
      "command": [
        "dev/atlas-segmentation-contract",
        "check"
      ]
    }
  ],
  "phases": [
    {
      "id": "worker-segmentation-webgpu-composite",
      "url": "http://127.0.0.1:8111/?learning=worker-segmentation-webgpu-composite&segmentation-model=mobilesam-vit-t",
      "driver": "dev/atlas-experiment-lib/drivers/visual-instinct-segmentation-composite.mjs",
      "timeout_ms": 120000,
      "restart_host": false,
      "input": {
        "composite_timeout_ms": 90000,
        "maximum_part_resolve_ms": 100,
        "maximum_composite_frame_ms": 100,
        "minimum_graph_parity_iou": 0.99,
        "minimum_changed_pixels": 1000,
        "expected": {
          "model_id": "mobilesam-vit-t",
          "contract_sha256": "6fca40e4674e9acf68c80e2046b10d51eb1257b19be07904f5fa6bb484b7425b",
          "recipe_id": "mechanical-owl-wing-flap-v1",
          "source_sha256": "21e3e650e1dfea74d09d5fca62b1da25431db3b4dac1bb3757f72583e04d917a",
          "worker_postprocess": "sam-low-res-bilinear-crop-source-v1",
          "shader_sha256": "a70e73f8c5891511aadb5e9f53a56fe01ab20ed9a59774cd53acf23b3c639619",
          "control_id": "flap",
          "motion_units": [
            35,
            -35
          ]
        }
      }
    }
  ]
}
